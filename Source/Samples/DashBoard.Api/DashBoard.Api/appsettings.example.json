{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dashboard": {
    "EnableSwagger": true,
    "ApiKey": "",
    "Interceptors": {
      "GZip": { "Enabled": true, "MinimumSize": 150 },
      "TripleDes": {
        "Enabled": false,
        "Key": "replace-with-32-char-key-or-leave-empty",
        "IV": "replace-with-11-char-iv="
      }
    },
    "Connections": [
      {
        "Transport": "SqlServer",
        "ConnectionString": "Server=localhost;Database=SampleDb;Integrated Security=True;TrustServerCertificate=True;",
        "DisplayName": "SQL Server",
        "Queues": [ "sampleQueue" ]
      },
      {
        "Transport": "PostgreSql",
        "ConnectionString": "Server=localhost;Port=5432;Database=sampledb;userid=postgres;password=changeme;Trust Server Certificate=true",
        "DisplayName": "PostgreSQL",
        "Queues": [ "sampleQueue" ]
      },
      {
        "Transport": "SQLite",
        "ConnectionString": "Data Source=%userprofile%\\Documents\\sample.db3;Version=3;",
        "DisplayName": "SQLite",
        "Queues": [ "sampleQueue" ]
      },
      {
        "Transport": "LiteDb",
        "ConnectionString": "Filename=%userprofile%\\Documents\\sample.db;Connection=shared;",
        "DisplayName": "LiteDB",
        "Queues": [ "sampleQueue" ]
      },
      {
        "Transport": "Redis",
        "ConnectionString": "localhost,defaultDatabase=1,syncTimeout=15000",
        "DisplayName": "Redis",
        "Queues": [ "sampleQueue" ]
      }
    ]
  },
  "DashboardApi": {
    "Sources": [
      {
        "Name": "Local",
        "BaseUrl": "http://localhost:5000",
        "ApiKey": ""
      }
    ]
  },
  "DashboardAuth": {
    "Username": "",
    "PasswordHash": ""
  }
}
