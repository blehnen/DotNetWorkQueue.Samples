<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <appSettings>
	  <add key="Database" value="Server=192.168.0.2;Port=5432;Database=integrationtesting;Maximum Pool Size=250;userid=brian;password=123abc;Trust Server Certificate=true" />
    <add key="QueueName" value="sampleQueueNew" />
    <add key="EnableTrace" value="false" />
    <add key="EnableMetrics" value="false" />
    <add key="EnableCompression" value="true" />
    <add key="EnableEncryption" value="true" />
    <add key="EnableChaos" value="false" />
    <add key="EnableDashboard" value="false" />
    <add key="DashboardApiUrl" value="https://192.168.0.2:9998" />
	  <add key="EnableHistory" value="true" />
  </appSettings>
</configuration>
