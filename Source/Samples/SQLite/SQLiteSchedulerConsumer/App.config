<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <appSettings>
    <add key="Database" value="\testScheduler.db3" />
    <add key="QueueName" value="testing" />
    <add key="EnableTrace" value="true" />
    <add key="EnableMetrics" value="true" />
    <add key="EnableCompression" value="true" />
    <add key="EnableEncryption" value="true" />
    <add key="EnableChaos" value="false" />
    <add key="EnableDashboard" value="false" />
    <add key="DashboardApiUrl" value="https://localhost:32906" />
  </appSettings>
</configuration>
