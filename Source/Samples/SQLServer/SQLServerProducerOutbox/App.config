<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
      <add key="Database" value="Server=192.168.0.2;Database=IntegrationTests;user=brian;password=123abc;TrustServerCertificate=True;" />
      <add key="QueueName" value="sampleQueueExample" />
      <add key="EnableTrace" value="true" />
      <add key="EnableMetrics" value="false" />
      <add key="EnableCompression" value="true" />
      <add key="EnableEncryption" value="true" />
      <add key="EnableChaos" value="false" />
      <add key="UseUserDequeue" value ="false"/>
      <add key="EnableHistory" value="true" />
    </appSettings>
</configuration>
