<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <appSettings>
    <add key="Database" value="Server=localhost;Application Name=Samples;Database=SampleDb;user=sa;password=yourpassword;max pool size=500;TrustServerCertificate=True;" />
    <add key="QueueName" value="sampleQueueExample" />
    <add key="EnableTrace" value="true" />
    <add key="EnableMetrics" value="false" />
    <add key="EnableCompression" value="true" />
    <add key="EnableEncryption" value="true" />
    <add key="EnableChaos" value="false" />
    <add key="EnableDashboard" value="false" />
    <add key="DashboardApiUrl" value="https://localhost:32906" />
    <add key="UseUserDequeue" value ="false"/>
    <add key="UserDayOfWeek" value ="1"/>
  </appSettings>
</configuration>
