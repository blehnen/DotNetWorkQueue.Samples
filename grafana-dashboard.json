{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    }
  ],
  "id": null,
  "uid": "dotnetworkqueue",
  "title": "DotNetWorkQueue",
  "description": "Queue metrics for DotNetWorkQueue via OpenTelemetry / Prometheus",
  "tags": ["dotnetworkqueue", "queue", "messaging"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "queue",
        "label": "Queue Name",
        "description": "Queue name prefix in metric names",
        "type": "query",
        "query": "label_values({__name__=~\"dotnetworkqueue_.*_CommitMessage_CommitCounter_Items\"}, __name__)",
        "regex": "/^dotnetworkqueue_(.+?)_CommitMessage_CommitCounter_Items$/",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "title": "Message Throughput",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Messages Sent",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_SendMessages_SendMessagesMeter_Items_total",
          "legendFormat": "Sent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Messages Received",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_ReceiveMessages_ReceiveMessageMeter_Items_total",
          "legendFormat": "Received"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Committed",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_CommitMessage_CommitCounter_Items",
          "legendFormat": "Committed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Rollbacks",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_RollbackMessage_RollbackCounter_Items",
          "legendFormat": "Rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Errors",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_ReceiveMessagesError_MessageFailedProcessingErrorMeter_Items_total",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Retries",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_ReceiveMessagesError_MessageFailedProcessingRetryMeter_Items_total",
          "legendFormat": "Retries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Send Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_SendMessages_SendMessagesMeter_Items_total[1m])",
          "legendFormat": "Sent/min"
        },
        {
          "expr": "rate(dotnetworkqueue_${queue}_ReceiveMessages_ReceiveMessageMeter_Items_total[1m])",
          "legendFormat": "Received/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Received/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "title": "Error & Retry Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_ReceiveMessagesError_MessageFailedProcessingErrorMeter_Items_total[1m])",
          "legendFormat": "Errors/min"
        },
        {
          "expr": "rate(dotnetworkqueue_${queue}_ReceiveMessagesError_MessageFailedProcessingRetryMeter_Items_total[1m])",
          "legendFormat": "Retries/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Errors/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "title": "Processing",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false
    },
    {
      "title": "Message Handler Duration (avg ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_MessageHandler_HandleTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_MessageHandler_HandleTimer_milliseconds_count[1m])",
          "legendFormat": "Avg handler time"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Commits & Rollbacks Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_CommitMessage_CommitCounter_Items[1m])",
          "legendFormat": "Commits/min"
        },
        {
          "expr": "rate(dotnetworkqueue_${queue}_RollbackMessage_RollbackCounter_Items[1m])",
          "legendFormat": "Rollbacks/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Rollbacks/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "title": "Heartbeat & Maintenance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "title": "Heartbeat Reset Count",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_ResetHeartBeat_ResetCounter_Items",
          "legendFormat": "Resets"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Expired Messages Cleared",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 23 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_ClearExpiredMessages_ClearMessages_ResetCounter_Items",
          "legendFormat": "Cleared"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Error Messages Cleared",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "dotnetworkqueue_${queue}_ClearErrorMessages_ResetCounter_Items",
          "legendFormat": "Cleared"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Heartbeat Send Time (avg ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 23 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_SendHeartBeat_SendTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_SendHeartBeat_SendTimer_milliseconds_count[1m])",
          "legendFormat": "Avg"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Serialization",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "title": "Serialization Time (avg ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_Serializer_ConvertMessageToBytesTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_Serializer_ConvertMessageToBytesTimer_milliseconds_count[1m])",
          "legendFormat": "Serialize"
        },
        {
          "expr": "rate(dotnetworkqueue_${queue}_Serializer_ConvertBytesToMessageTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_Serializer_ConvertBytesToMessageTimer_milliseconds_count[1m])",
          "legendFormat": "Deserialize"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Avg Message Size (bytes)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_Serializer_ConvertMessageToBytesHistogram_Bytes_sum[1m]) / rate(dotnetworkqueue_${queue}_Serializer_ConvertMessageToBytesHistogram_Bytes_count[1m])",
          "legendFormat": "Avg size"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Interceptors",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false
    },
    {
      "title": "Interceptor Time (avg ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_MessageInterceptor_MessageToBytesTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_MessageInterceptor_MessageToBytesTimer_milliseconds_count[1m])",
          "legendFormat": "Encode"
        },
        {
          "expr": "rate(dotnetworkqueue_${queue}_MessageInterceptor_BytesToMessageTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_MessageInterceptor_BytesToMessageTimer_milliseconds_count[1m])",
          "legendFormat": "Decode"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Internal Serialization Time (avg ms)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_InternalSerializer_ConvertToBytesTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_InternalSerializer_ConvertToBytesTimer_milliseconds_count[1m])",
          "legendFormat": "Serialize (internal)"
        },
        {
          "expr": "rate(dotnetworkqueue_${queue}_InternalSerializer_ConvertBytesToTimer_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_InternalSerializer_ConvertBytesToTimer_milliseconds_count[1m])",
          "legendFormat": "Deserialize (internal)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Message Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "collapsed": false
    },
    {
      "title": "Message Latency (avg ms)",
      "description": "Time between enqueue and dequeue — how long messages sit in the queue before being picked up",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "targets": [
        {
          "expr": "rate(dotnetworkqueue_${queue}_ReceiveMessages_WaitForDeQueueMeter_milliseconds_sum[1m]) / rate(dotnetworkqueue_${queue}_ReceiveMessages_WaitForDeQueueMeter_milliseconds_count[1m])",
          "legendFormat": "Avg latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Message Latency Distribution",
      "description": "Histogram of message latency buckets",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(dotnetworkqueue_${queue}_ReceiveMessages_WaitForDeQueueMeter_milliseconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(dotnetworkqueue_${queue}_ReceiveMessages_WaitForDeQueueMeter_milliseconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(dotnetworkqueue_${queue}_ReceiveMessages_WaitForDeQueueMeter_milliseconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
